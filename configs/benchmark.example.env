# Required paths
SGLANG_RUNTIME_HOME=/path/to/sglang-runtime
SGLANG_VENV=/path/to/sglang-runtime/venv
SGLANG_SOURCE=/path/to/sglang-source
ALLOW_DIRTY_SGLANG=0
MODEL_PATH=/path/to/model

# Stable run identity
RUN_ID=my-gpu-my-model-YYYYMMDD-HHMMSS
TESTER=github-or-display-name
DATA_AUTHOR=github-or-display-name
MODEL_NAME=my-model
MODEL_REPOSITORY=https://huggingface.co/owner/model
MODEL_REVISION=immutable-huggingface-commit

# Server configuration. Use auto for the model-native context, or an explicit
# value that does not exceed the model limit.
CONTEXT_LENGTH=auto
MAX_TOTAL_TOKENS=auto
MEM_FRACTION_STATIC=0.90
MAX_CONCURRENCY_LIST="1 4"
EXPECTED_POWER_LIMIT=250
TP_SIZE=1
CUDA_VISIBLE_DEVICES=0

# Add "enabled" only after confirming a compatible integrated MTP/EAGLE head.
MTP_MODES="disabled"
MTP_ALGORITHM=EAGLE
MTP_STEPS=3
MTP_TOPK=1
MTP_DRAFT_TOKENS=4

# core: comparable 1K-20K matrix; extended: add 32K-131K cases when they fit.
MATRIX_TIERS="core extended"
PREFILL_REQUESTS=3
GENERATION_REQUESTS=3
CONCURRENT_WAVES=5
# MATRIX_FILE=/path/to/additional-cases.json

# Optional SGLang arguments. Leave blank unless the model requires them.
QUANTIZATION=
ATTENTION_BACKEND=
LINEAR_ATTN_BACKEND=
SAMPLING_BACKEND=
REASONING_PARSER=
TOOL_CALL_PARSER=
TRUST_REMOTE_CODE=0
EXTRA_SERVER_ARGS=

# Optional per-profile overrides. The runner checks the most specific name
# first, for example C4_MTP_ENABLED, then MTP_ENABLED, then the global value.
# MEM_FRACTION_STATIC_MTP_DISABLED=0.88
# MEM_FRACTION_STATIC_MTP_ENABLED=0.94
# MEM_FRACTION_STATIC_C4_MTP_ENABLED=0.98
# MAX_TOTAL_TOKENS_C4_MTP_ENABLED=20480

# Optional dataset identities to include in metadata. The standard fixed-length
# pipeline does not run them automatically; publish only pre-tokenized,
# capacity-safe dataset runs.
SHAREGPT_PATH=
LONGBENCH_PATH=
